{
  "name": "nextjs-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "test": "jest --reporters default",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:setup": "playwright install ffmpeg chromium firefox",
    "lint": "eslint src/ ",
    "lint:fix": "pnpm lint --fix",
    "lint:staged": "lint-staged --config lint-staged.config.mjs",
    "lint:commit": "commitlint --config commitlint.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "cleanup": "rm -rf out dist .next .swc coverage test-results",
    "reset": "pnpm cleanup && rm -rf node_modules pnpm-lock.yaml && pnpm install --offline",
    "prepare": "is-ci >/dev/null 2>&1 || husky"
  },
  "dependencies": {
    "@base-ui/react": "~1.7.0",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "lucide-react": "~1.28.0",
    "next": "~16.3.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "shadcn": "~4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "~3.6.0",
    "tw-animate-css": "~1.4.0",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
